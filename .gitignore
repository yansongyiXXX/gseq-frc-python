# ============================================================
# GSEQ-FRC Python 修改版 —— 版本管理范围
#
# 原则：只纳管「人写的东西」——源码、测试、配置、文档。
# 凡是「跑出来的东西」（产物、日志、缓存）和「大的二进制」
# 一律排除。它们随时能重新生成，放进 git 只会让仓库变慢变肿。
#
# 需要临时纳管某个被排除的文件时，用：
#     git add -f <路径>
# ============================================================

# ---- 构建与工具缓存 ----
.codex-build/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
node_modules/

# ---- 运行产物与中间结果 ----
outputs/
outputs_backup_*/
_ppt_work/
_lo_profile/
*.log

# ---- 数据与二进制文件 ----
*.mat
*.npz
*.npy
*.dat
*.zip
*.pdf
*.pptx
*.gif

# ---- 手工备份文件（git 本身就是备份，不再需要 .bak）----
*.bak
*.bak-*
*~

# ---- 编辑器与系统杂项 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
